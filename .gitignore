# Global context: keep secrets, local environments, generated models, and run artifacts out of Git.
# Source: https://git-scm.com/docs/gitignore
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
logs/
artifacts/
checkpoints/
.cache/
.trackio/
*.egg-info/
dist/
build/
output/pdf/*.aux
output/pdf/*.fdb_latexmk
output/pdf/*.fls
output/pdf/*.log
output/pdf/*.out
output/pdf/*.synctex.gz
paper/*.aux
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
paper/*.synctex.gz
*:Zone.Identifier
